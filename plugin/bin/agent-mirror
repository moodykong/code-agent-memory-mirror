#!/usr/bin/env python3
"""Launcher for agent-mirror: runs the agent_mirror package that sits next to this folder.

Works through a symlink (for example ~/.local/bin/agent-mirror), because the
real location of this file is used to find the package.
"""

import os
import sys

if sys.version_info < (3, 8):
    sys.stderr.write("error: agent-mirror needs Python 3.8 or newer (this is %s)\n" % sys.version.split()[0])
    sys.exit(2)

HERE = os.path.dirname(os.path.realpath(os.path.abspath(__file__)))
sys.path.insert(0, os.path.dirname(HERE))

from agent_mirror.cli import main  # noqa: E402

sys.exit(main())
