{
  "repo": "example-org/my-project",
  "python": "3.11.9",
  "dependency_sync": "uv sync --frozen",
  "memory_project": "my-project",
  "allowed_hosts": [
    "api.example.com",
    "*.blob.core.windows.net"
  ],
  "env_var_names": [
    "EXAMPLE_API_TOKEN",
    "AZURE_CLIENT_ID",
    "AZURE_CLIENT_SECRET",
    "AZURE_TENANT_ID"
  ],
  "secrets": [
    {
      "recipe": "local-file",
      "path": "~/.secrets/my-project.env",
      "names": [
        "EXAMPLE_API_TOKEN"
      ]
    },
    {
      "recipe": "env",
      "names": [
        "AZURE_CLIENT_ID"
      ]
    },
    {
      "recipe": "azure-keyvault",
      "vault": "my-key-vault",
      "secrets": {
        "AZURE_CLIENT_SECRET": "agent-client-secret"
      }
    },
    {
      "recipe": "literal",
      "name": "AZURE_TENANT_ID",
      "value": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "setup_commands": [
    "apt-get install -y -qq jq"
  ],
  "session_start_commands": [
    "{store}/projects/my-project/cloud-login.sh"
  ],
  "box": {
    "backend": "azure-blob",
    "storage_account": "mystorageaccount",
    "shared_container": "agent-box-shared",
    "sessions_container": "agent-box-sessions",
    "prefix": "my-project",
    "include": [
      "results/**",
      "docs/slides/**",
      "figures/**"
    ],
    "exclude": [
      "results/scratch/**",
      "**/__pycache__/**",
      "**/.env",
      "**/*.env"
    ],
    "archives": [
      "ws-*"
    ],
    "archive_large_file_bytes": 52428800,
    "min_free_bytes": 2147483648
  },
  "probe": {
    "https_urls": [
      "https://api.example.com"
    ],
    "tcp_hosts": [
      "db.example.com:5432"
    ],
    "commands": [
      {
        "name": "API reachable with the project's own client",
        "run": "uv run --frozen python -c \"print('ok')\""
      }
    ]
  },
  "pointers_file": "projects/my-project/data_pointers.json"
}
